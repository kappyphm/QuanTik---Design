# Server-side only. Never put access tokens or integration keys here.
QUANTIK_API_URL=http://127.0.0.1:8000
QUANTIK_UPSTREAM_ORIGIN=http://localhost:3000
QUANTIK_APP_ORIGIN=http://localhost:3000
# Google OAuth's configured public callback must reach Next's
# /api/v1/auth/google/callback. See docs/ACCOUNT-ADMIN-IMPLEMENTATION.md.
# Start BE with process env QUANTIK_PUBLIC_ORIGIN=http://localhost:3000
# so callback and refresh/exchange Origin agree. No BE source change needed.

# Optional actual support channel: HTTPS page or mailto address.
# Empty uses support@quantik.example, explicitly labeled as a demo email.
QUANTIK_SUPPORT_URL=
